{
  "name": "kanivet-frontend",
  "version": "0.1.1",
  "description": "Kubernetes cluster navigation and troubleshooting application",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:standalone": "vite build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:unit",
    "test:node": "node --test public/telemetry.test.js public/legacyHostedIdentityMigration.test.js public/electron.test.js src/utils/legacyChatSessionMigration.test.js",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "dev": "concurrently \"BROWSER=none npm start\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build:backend": "cd ../backend && go mod download && go build -ldflags=\"-s -w\" -trimpath -o ../frontend/resources/kanivet-backend ./cmd/main.go",
    "build:app": "npm run build && npm run build:backend",
    "build:app:standalone": "npm run build:standalone && npm run build:backend",
    "dist": "npm run build:app && npm run clean:dist && electron-builder",
    "dist:standalone": "npm run build:app:standalone && npm run clean:dist && electron-builder --config.productName=kanivet-standalone --config.publish.channel=standalone",
    "dist:mac": "npm run build:app && npm run clean:dist && DEBUG=electron-builder electron-builder --mac",
    "dist:mac:dir": "npm run build:app && npm run clean:dist && electron-builder --mac dir",
    "dist:mac:ci": "npm run build && npm run clean:dist && electron-builder --mac",
    "dist:mac:standalone": "npm run build:app:standalone && npm run clean:dist && DEBUG=electron-builder electron-builder --mac --config.productName=kanivet-standalone --config.publish.channel=standalone",
    "dist:win": "npm run build:app && npm run clean:dist && electron-builder --win",
    "dist:linux": "npm run build:app && npm run clean:dist && electron-builder --linux",
    "clean:dist": "rm -rf dist && find build -name '*.map' -delete 2>/dev/null || true",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.kanivet.app",
    "productName": "kanivet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/legacyHostedIdentityMigration.js",
      "public/preload.js",
      "public/telemetry.js",
      "resources/**/*"
    ],
    "asarUnpack": [
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "type": "distribution",
      "entitlements": "./entitlements.mac.plist",
      "timestamp": "http://timestamp.apple.com/ts01",
      "signIgnore": [
        "/Electron Framework\\.framework/Versions/"
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "electronLanguages": [
      "en"
    ],
    "buildDependenciesFromSource": false,
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "compression": "normal"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.kanivet.io"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.6.0",
    "chart.js": "^4.5.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "clsx": "^2.0.0",
    "electron-dynamic-island": "^1.1.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.52.2",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.0",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
